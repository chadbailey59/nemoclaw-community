#
# Copy to .env and fill in. Never commit .env.

# --- The sandbox being watched -------------------------------------------
# The NemoClaw sandbox running the research agent. The gatekeeper watches this
# sandbox for blocked sources and applies approvals to it.
NEMOCLAW_SANDBOX=nc

# Path to the OpenShell CLI. This must stay HOST-side: it is what applies an
# approval, and the sandbox must not be able to reach it. Do not install
# openshell into the sandbox image.
# OPENSHELL_BIN=openshell

# Hosts opened without asking, comma separated. Everything else interrupts a
# human. Keep this short: each entry is a source you have decided you no longer
# want to hear about.
# RESEARCH_AUTO_ALLOW=

# --- Voice profile -------------------------------------------------------
# Picks STT, LLM, and TTS together. Mixing across profiles is not supported.
#   hosted -> Deepgram STT, Nemotron on Baseten, Gradium TTS
#   local  -> Parakeet ASR, Nemotron, Magpie TTS, all on NIMs you host
VOICE_PROFILE=hosted

# --- hosted profile ------------------------------------------------------
DEEPGRAM_API_KEY=
BASETEN_API_KEY=
GRADIUM_API_KEY=

# Defaults to nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B on Baseten's shared
# Model APIs. Nano and Super are faster and better suited to a voice loop, but
# are served from dedicated deployments: set both of these together.
# BASETEN_BASE_URL=https://model-{model_id}.api.baseten.co/environments/production/sync/v1
# BASETEN_MODEL=nvidia/NVIDIA-Nemotron-3-Nano
# GRADIUM_VOICE_ID=

# --- local profile (VOICE_PROFILE=local) ---------------------------------
# Self-hosted NVIDIA NIMs, no hosted speech vendor. Each Riva NIM serves gRPC
# on 50051 inside its own container, so publish the TTS one on another host
# port when both run on one machine.
# NVIDIA_ASR_SERVER=localhost:50051
# NVIDIA_TTS_SERVER=localhost:50052
# NVIDIA_LLM_BASE_URL=http://localhost:8000/v1
# NVIDIA_LLM_MODEL=nvidia/nvidia-nemotron-3-nano
# NVIDIA_TTS_VOICE=

# --- Agent loop: OpenClaw Gateway in the NemoClaw sandbox -----------------
# 18790 is the port a NemoClaw sandbox publishes, not OpenClaw's own 18789.
# Check yours with: nemoclaw list
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18790
# OPENCLAW_SESSION_KEY=agent:main:main
# OPENCLAW_TIMEOUT_SECS=300
# OPENCLAW_TOKEN=
# OPENCLAW_PASSWORD=
